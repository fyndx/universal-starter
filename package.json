{
  "name": "universal-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "validation": {
        "zod": "^4.0.17"
      },
      "devDeps": {
        "@biomejs/biome": "2.2.2",
        "typescript": "^5.9.2"
      }
    }
  },
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "android": "bun run --filter './apps/frontend' android",
    "ios": "bun run --filter './apps/frontend' ios",
    "web": "bun run --filter './apps/frontend' web"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:devDeps",
    "@types/bun": "latest",
    "lefthook": "^1.12.3",
    "typescript": "catalog:devDeps",
    "ultracite": "5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
