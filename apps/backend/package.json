		"prisma": "^6.15.0",
		"typescript": "catalog:devDeps"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*",
			"import": "./src/*"
		}
