{
	"name": "@universal/backend",
	"version": "1.0.50",
	"private": true,
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
		"test": "echo \"Error: no test specified\" && exit 1",
		"db:generate": "prisma generate",
		"db:studio": "prisma studio",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:seed": "bun prisma/seeds/index.ts",
		"db:reset": "prisma migrate reset"
	},
	"dependencies": {
		"@better-auth/expo": "^1.3.7",
		"@bogeychan/elysia-logger": "^0.1.10",
		"@elysiajs/cors": "^1.3.3",
		"@elysiajs/opentelemetry": "^1.3.1",
		"@elysiajs/server-timing": "^1.3.0",
		"@elysiajs/static": "^1.3.0",
		"@elysiajs/swagger": "^1.3.1",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.203.0",
		"@opentelemetry/sdk-trace-node": "^2.0.1",
		"@plunk/node": "^3.0.3",
		"@prisma/client": "^6.15.0",
		"@prisma/extension-accelerate": "^2.0.1",
		"@readme/http-status-codes": "^9.0.4",
		"@sinclair/typebox": "^0.34.40",
		"better-auth": "^1.3.7",
		"bullmq": "^5.58.2",
		"elysia": "latest",
		"elysia-rate-limit": "^4.4.0",
		"ioredis": "^5.7.0",
