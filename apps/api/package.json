{
  "name": "@universal/api",
  "version": "1.0.50",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.3.7",
    "@bogeychan/elysia-etag": "^0.1.0",
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/opentelemetry": "^1.3.1",
    "@elysiajs/server-timing": "^1.3.0",
    "@elysiajs/static": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.203.0",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@plunk/node": "^3.0.3",
    "@readme/http-status-codes": "^9.0.4",
    "@sinclair/typebox": "^0.34.40",
    "@universal/db": "workspace:*",
    "@universal/logger": "workspace:*",
    "@universal/queue-kit": "workspace:*",
    "@universal/redis": "workspace:*",
    "@universal/shared": "workspace:*",
    "better-auth": "^1.3.7",
    "bullmq": "^5.58.2",
    "elysia": "^1.3.20",
    "elysia-rate-limit": "^4.4.0",
    "ioredis": "^5.7.0",
    "lru-cache": "^11.1.0",
    "nodemailer": "^7.0.5",
    "pino-pretty": "^13.1.1",
    "resend": "^4.8.0",
    "zod": "catalog:validation"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "catalog:devDeps"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "module": "src/index.ts"
}
