{
	"name": "@universal/api",
	"version": "1.0.50",
	"private": true,
	"main": "./src/index.ts",
	"module": "src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"import": "./src/types.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
		"test": "bun test",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/expo": "^1.4.1",
		"@bogeychan/elysia-etag": "^0.1.0",
		"@bogeychan/elysia-logger": "^0.1.10",
		"@elysiajs/cors": "^1.4.0",
		"@elysiajs/openapi": "^1.4.11",
		"@elysiajs/opentelemetry": "^1.4.6",
		"@elysiajs/server-timing": "^1.4.0",
		"@elysiajs/static": "^1.4.4",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.207.0",
		"@opentelemetry/sdk-trace-node": "^2.2.0",
		"@plunk/node": "^3.0.3",
		"@readme/http-status-codes": "^9.0.5",
		"@sinclair/typebox": "^0.34.41",
		"@universal/db": "workspace:*",
		"@universal/logger": "workspace:*",
		"@universal/queue-kit": "workspace:*",
		"@universal/redis": "workspace:*",
		"@universal/shared": "workspace:*",
		"better-auth": "^1.4.1",
		"elysia": "^1.4.16",
		"elysia-rate-limit": "^4.4.2",
		"ioredis": "^5.8.2",
		"lru-cache": "^11.2.2",
		"nodemailer": "^7.0.10",
		"pino-pretty": "^13.1.2",
		"resend": "^4.8.0",
		"zod": "catalog:validation"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/nodemailer": "^7.0.0",
		"bullmq": "^5.58.4",
		"typescript": "catalog:devDeps"
	}
}
