{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "~components/*": ["./src/components/*"],
      "~lib/*": ["./src/lib/*"],
      "@/*": ["./*"]
    },
    "declaration": false
  },
  "references": [
    {
      "path": "../api"
    }
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
