{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "extends": ["ultracite/core", "ultracite/react"],
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    }
  },
  "overrides": [
    {
      "includes": ["**/*.jsonc", "tsconfig*.json", "biome.jsonc"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ]
}
